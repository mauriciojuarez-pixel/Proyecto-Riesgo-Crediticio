<!-- frontend/src/views/dashboard.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - Riesgo Crediticio</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            margin: 0;
        }

        nav {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            padding: 16px 30px;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        nav span {
            font-weight: 600;
            font-size: 15px;
        }

        nav a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            background: #ef4444;
            padding: 8px 14px;
            border-radius: 8px;
            transition: background 0.2s ease;
        }

        nav a:hover {
            background: #dc2626;
        }

        .dashboard-container {
            padding: 30px;
            max-width: 1100px;
            margin: auto;
        }

        .dashboard-header {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: #ffffff;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .card h3 {
            margin: 0;
            font-size: 14px;
            color: #64748b;
        }

        .card p {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            margin-top: 8px;
        }

        .action-section {
            margin-top: 20px;
            display: flex;
            justify-content: center;
        }

        .btn-risk {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            padding: 14px 26px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            font-size: 15px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-risk:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(37,99,235,0.35);
        }
    </style>
</head>
<body>

    <nav>
        <span>Hola, <%= user.username %></span>
        <a href="/auth/logout">Cerrar Sesión</a>
    </nav>

    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="card">
                <h3>ID de Usuario</h3>
                <p><%= user.user_id %></p>
            </div>
            <div class="card">
                <h3>Correo Electrónico</h3>
                <p><%= user.email %></p>
            </div>
        </div>

        <div class="action-section">
            <a href="/dashboard/risk">
                <button class="btn-risk">Evaluar Riesgo Crediticio</button>
            </a>
        </div>
    </div>

</body>
</html>
